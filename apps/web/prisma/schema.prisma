generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(uuid())
  githubId        String       @unique
  githubUsername  String?
  ckbAddress      String?      @unique
  bio             String?
  isProfilePublic Boolean      @default(true)
  autoSync        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  repositories    Repository[]
}

model Repository {
  id              String   @id @default(uuid())
  githubRepoId    String   @unique
  name            String
  fullName        String
  isBackedUp      Boolean  @default(false)
  isPrivate       Boolean  @default(false)
  commitCount     Int      @default(0)
  cachedTree      Json?
  cachedCommits   Json?
  lastBackupCid   String?
  ckbTxHash       String?
  // Outpoint ("0x<txHash>:<index>") of this repo's anchor cell. Reused and
  // rewritten on every backup so on-chain growth is one cell per repo, not one
  // cell per backup.
  ckbCellOutpoint String?
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
