generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(uuid())
  githubId        String       @unique
  githubUsername  String?
  ckbAddress      String?      @unique
  ckbAddressVerifiedAt DateTime?
  bio             String?
  isProfilePublic Boolean      @default(true)
  autoSync        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  repositories    Repository[]
  walletChallenge WalletChallenge?
  cotaRegistration CotaRegistration?
  cotaUpdates     CotaUpdate[]
  cotaManifestOperations CotaManifestOperation[]
  cotaManifestEnrollment CotaManifestEnrollment?
  workerDispatches WorkerDispatch[]
}

model WalletChallenge {
  id        String   @id @default(uuid())
  userId    String   @unique
  address   String
  message   String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CotaRegistration {
  userId      String   @id
  address     String   @unique
  txHash      String
  outputIndex Int
  transaction Json?
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([txHash, outputIndex])
}

model Repository {
  id              String   @id @default(uuid())
  githubRepoId    String   @unique
  githubNumericId String?  @unique
  name            String
  fullName        String
  isBackedUp      Boolean  @default(false)
  isPrivate       Boolean  @default(false)
  commitCount     Int      @default(0)
  cachedTree      Json?
  cachedCommits   Json?
  lastBackupCid   String?
  ckbTxHash       String?
  // Outpoint ("0x<txHash>:<index>") of this repo's anchor cell. Reused and
  // rewritten on every backup so on-chain growth is one cell per repo, not one
  // cell per backup.
  ckbCellOutpoint String?
  encryptionKey   String?
  encryptionIv    String?
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CotaUpdate {
  id                  String   @id @default(uuid())
  userId              String
  sourceOutpoint      String
  protocol            String   @default("cota-smt-v1")
  txHash              String
  root                String
  previousRoot        String
  records             Json
  leaves              Json
  unsignedTransaction Json
  signedTransaction   Json?
  status              String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, sourceOutpoint, protocol])
  @@index([userId, createdAt])
}

model WorkerDispatch {
  id        String   @id
  userId    String
  kind      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// One reservation for an actual CoTA cell, shared by all publication protocols.
// A lease can replace only an unpublished build. Accepted bytes retain the
// reservation through broadcast uncertainty until a confirmed successor exists.
model PublicationStream {
  id              String   @id @default(uuid())
  network         String
  cotaScriptHash  String
  revision        Int      @default(0)
  headOutpoint    String?
  reservationId   String?  @unique
  reservedUntil   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  operations      CotaManifestOperation[]

  @@unique([network, cotaScriptHash])
}

model CotaManifestOperation {
  id                    String   @id @default(uuid())
  userId                String?
  streamId              String
  protocol              String   @default("cota-manifest-v1")
  kind                  String
  sourceOutpoint        String
  revision              Int
  snapshot              Json
  unsignedTransaction   Json?
  serializedUnsignedTransaction String?
  planDigest            String?
  plan                  Json?
  root                  String?
  previousRoot          String?
  txHash                String?
  status                String
  acceptedAttemptId     String?  @unique
  confirmedTransaction  Json?
  diagnostics           Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  stream                PublicationStream @relation(fields: [streamId], references: [id], onDelete: Restrict)
  attempts              CotaManifestSignedAttempt[]

  @@index([userId, createdAt])
  @@index([streamId, createdAt])
}

model CotaManifestSignedAttempt {
  id                    String   @id @default(uuid())
  operationId           String
  digest                String
  signedTransaction     Json
  serializedTransaction String
  txHash                String
  preflight             String   @default("pending")
  diagnostics           Json?
  status                String   @default("validating")
  firstBroadcastAt      DateTime?
  lastBroadcastAt       DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  operation             CotaManifestOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@unique([operationId, digest])
  @@index([operationId, createdAt])
}

// Issuer-authenticated binding of an immutable GitHub account/wallet to its
// designated pair. Token identifiers are retained across retries and snapshots.
model CotaManifestEnrollment {
  userId              String   @id
  ownerLockHash       String
  issuerLockHash      String
  collectionId        String
  tokenIndexes        Json
  issuanceOperationId String?  @unique
  issuanceTxHash      String?
  initialManifest     Json
  status              String
  claimTxHash         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}
