# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/rivet"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Public URL of this deployment. Optional on Vercel: it falls back to the
# platform-provided VERCEL_URL. Set it explicitly once you have a stable domain.
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ---------------------------------------------------------------------------
# GitHub OAuth App (scopes: read:user user:email repo)
# ---------------------------------------------------------------------------
GITHUB_ID=""
GITHUB_SECRET=""

# Signing secret for /api/webhook/github push payloads.
GITHUB_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Workers (GitHub Actions) - optional overrides
# ---------------------------------------------------------------------------
# On Vercel these are auto-detected from VERCEL_GIT_REPO_OWNER,
# VERCEL_GIT_REPO_SLUG and VERCEL_GIT_COMMIT_REF. Only set them when running
# somewhere other than Vercel.
# The older PROOF_* names are still accepted as a fallback.
RIVET_REPO_OWNER=""
RIVET_REPO_NAME=""
RIVET_REPO_REF=""
RIVET_BACKUP_WORKFLOW="backup.yml"
RIVET_RESTORE_WORKFLOW="restore.yml"

# Needed ONLY for webhook-driven auto-sync, which has no user session whose
# OAuth token can be borrowed. Interactive "Backup Now" works without it.
GH_DISPATCH_TOKEN=""

# Optional. Defaults to NEXTAUTH_SECRET, which fits the job and avoids creating
# another value to keep in sync across Vercel and the repo.
BACKUP_CALLBACK_SECRET=""

# ---------------------------------------------------------------------------
# GitHub Actions secrets
# Configure at: repo -> Settings -> Secrets and variables -> Actions
# (PINATA_JWT and TREASURY_PRIVATE_KEY are copy-paste from this file.)
# ---------------------------------------------------------------------------
PINATA_JWT=""
TREASURY_PRIVATE_KEY=""
REPO_CLONE_TOKEN=""
