# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/rivet"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Public URL of this deployment. Optional on Vercel: it falls back to the
# platform-provided VERCEL_URL. Set it explicitly once you have a stable domain.
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ---------------------------------------------------------------------------
# GitHub OAuth App (scopes: read:user user:email repo admin:repo_hook)
# ---------------------------------------------------------------------------
GITHUB_ID=""
GITHUB_SECRET=""

# Signing secret for /api/webhook/github push payloads.
GITHUB_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Workers (GitHub Actions) - optional overrides
# ---------------------------------------------------------------------------
# On Vercel these are auto-detected from VERCEL_GIT_REPO_OWNER,
# VERCEL_GIT_REPO_SLUG and VERCEL_GIT_COMMIT_REF. Only set them when running
# somewhere other than Vercel.
# The older PROOF_* names are still accepted as a fallback.
RIVET_REPO_OWNER=""
RIVET_REPO_NAME=""
RIVET_REPO_REF=""
RIVET_BACKUP_WORKFLOW="backup.yml"
RIVET_RESTORE_WORKFLOW="restore.yml"

# Required for backup, restore, and webhook-driven auto-sync. Use a token from
# the worker repository's owner with Actions: read and write on that repository.
# Users' OAuth tokens access their repositories; they do not dispatch Rivet's
# shared worker. See docs/WORKER_SETUP.md.
GH_DISPATCH_TOKEN=""

RIVET_WORKERS_ENABLED="true"
RIVET_WORKER_USER_HOURLY_LIMIT="10"
RIVET_WORKER_GLOBAL_HOURLY_LIMIT="50"
RIVET_WORKER_GLOBAL_DAILY_LIMIT="200"

# Optional. Defaults to NEXTAUTH_SECRET, which fits the job and avoids creating
# another value to keep in sync across Vercel and the repo.
BACKUP_CALLBACK_SECRET=""

# ---------------------------------------------------------------------------
# GitHub Actions secrets
# Configure at: repo -> Settings -> Secrets and variables -> Actions
# (PINATA_JWT and TREASURY_PRIVATE_KEY are copy-paste from this file.)
# ---------------------------------------------------------------------------
PINATA_JWT=""
TREASURY_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# Optional CoTA identity onboarding (CKB testnet only)
# Keep disabled until the identity schema is applied and a dedicated testnet
# sponsor wallet is funded. Never use a mainnet/private user wallet key here.
# ---------------------------------------------------------------------------
COTA_SPONSOR_ENABLED="false"
COTA_SPONSOR_PRIVATE_KEY=""
COTA_SPONSOR_MAX_REGISTRATIONS="10"
CKB_TESTNET_RPC_URL="https://testnet.ckb.dev/"
CKB_RPC_IP_FAMILY=""
COTA_REGISTRY_URL="https://cota.nervina.dev/registry-aggregator"

# Optional user-owned manifest lifecycle. Apply cota:manifest:setup and complete
# cota:issuer registration/definition before configuring the collection.
COTA_MANIFEST_ENABLED="false"
COTA_MANIFEST_ISSUER_PRIVATE_KEY=""
COTA_MANIFEST_COLLECTION_ID=""
# 0 = no account cap; positive values are optional enrollment trial budgets.
COTA_MANIFEST_MAX_ENROLLMENTS="0"
COTA_AGGREGATOR_URL="https://cota.nervina.dev/aggregator"
