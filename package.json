{
  "name": "proof",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "description": "PROOF — Provable Repository of Open & Onchain Files",
  "scripts": {
    "dev": "pnpm --filter @proof/web dev",
    "rivet": "node packages/cli/src/cli.mjs",
    "build": "pnpm --filter @proof/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean"
  },
  "keywords": [
    "ckb",
    "rgb++",
    "ccc",
    "git",
    "decentralized",
    "code-hosting",
    "blockchain"
  ],
  "license": "MIT",
  "engines": {
    "node": "24.x",
    "pnpm": "12.4.x"
  },
  "devDependencies": {
    "netlify-cli": "^27.8.0",
    "vercel": "^59.22.0"
  }
}
